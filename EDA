import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestRegressor, GradientBoostingRegressor
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score

# ==========================================
# 1. GENERATE SYNTHETIC DATASET (or load your CSV)
# ==========================================
# Replace this section with: df = pd.read_csv('your_car_data.csv')
np.random.seed(42)
n_samples = 1000

data = {
    'Year': np.random.randint(2008, 2024, size=n_samples),
    'Kilometers_Driven': np.random.randint(5000, 180000, size=n_samples),
    'Fuel_Type': np.random.choice(['Petrol', 'Diesel', 'CNG'], size=n_samples, p=[0.5, 0.4, 0.1]),
    'Transmission': np.random.choice(['Manual', 'Automatic'], size=n_samples, p=[0.7, 0.3]),
    'Owner_Type': np.random.choice(['First', 'Second', 'Third'], size=n_samples, p=[0.6, 0.3, 0.1]),
    'Engine_CC': np.random.choice([1000, 1200, 1500, 2000, 2500], size=n_samples),
}

# Calculate realistic target prices based on features
base_price = (data['Year'] - 2000) * 1200 + (data['Engine_CC'] * 4)
km_penalty = (data['Kilometers_Driven'] / 10000) * 350
transmission_bonus = np.where(data['Transmission'] == 'Automatic', 2500, 0)
fuel_bonus = np.where(data['Fuel_Type'] == 'Diesel', 1800, 0)

price = base_price - km_penalty + transmission_bonus + fuel_bonus + np.random.normal(0, 1500, n_samples)
data['Selling_Price'] = np.maximum(price, 1500) # Ensure no non-positive prices

df = pd.DataFrame(data)

print("--- RAW DATASET OVERVIEW ---")
print(df.head())
print("\nMissing Values Check:\n", df.isnull().sum())

# ==========================================
# 2. FEATURE ENGINEERING & PREPROCESSING
# ==========================================
# Compute Vehicle Age from manufacturing year
df['Car_Age'] = 2026 - df['Year']
df.drop(columns=['Year'], inplace=True)

# Separate Features (X) and Target (y)
X = df.drop(columns=['Selling_Price'])
y = df['Selling_Price']

# Log transform target variable to handle right-skewness
y_log = np.log1p(y)

# One-Hot Encode categorical features (Fuel_Type, Transmission, Owner_Type)
X_encoded = pd.get_dummies(X, drop_first=True)

print(f"\nEngineered Feature Set Shape: {X_encoded.shape}")

# ==========================================
# 3. TRAIN-TEST SPLIT
# ==========================================
X_train, X_test, y_train, y_test = train_test_split(
    X_encoded, y_log, test_size=0.2, random_state=42
)

# ==========================================
# 4. MODEL TRAINING & PREDICTION
# ==========================================
model = RandomForestRegressor(n_estimators=150, max_depth=12, random_state=42)
model.fit(X_train, y_train)

# Predict on test set
y_pred_log = model.predict(X_test)

# Convert predictions back to original currency scale
y_actual = np.expm1(y_test)
y_pred = np.expm1(y_pred_log)

# ==========================================
# 5. MODEL EVALUATION METRICS
# ==========================================
mae = mean_absolute_error(y_actual, y_pred)
rmse = np.sqrt(mean_squared_error(y_actual, y_pred))
r2 = r2_score(y_actual, y_pred)

print("\n--- MODEL PERFORMANCE ---")
print(f"Mean Absolute Error (MAE): ${mae:,.2f}")
print(f"Root Mean Squared Error (RMSE): ${rmse:,.2f}")
print(f"R² Score: {r2:.4f}")

# ==========================================
# 6. VISUALIZATIONS (MATPLOTLIB & SEABORN)
# ==========================================
plt.figure(figsize=(14, 5))

# Plot 1: Actual vs Predicted Prices
plt.subplot(1, 2, 1)
plt.scatter(y_actual, y_pred, alpha=0.6, color='blue', edgecolors='k')
plt.plot([y_actual.min(), y_actual.max()], [y_actual.min(), y_actual.max()], 'r--', lw=2)
plt.title("Actual vs. Predicted Car Prices")
plt.xlabel("Actual Price ($)")
plt.ylabel("Predicted Price ($)")
plt.grid(True, linestyle='--', alpha=0.5)

# Plot 2: Top Feature Importances
plt.subplot(1, 2, 2)
importances = pd.Series(model.feature_importances_, index=X_encoded.columns)
importances.nlargest(8).sort_values().plot(kind='barh', color='teal')
plt.title("Top Feature Importances")
plt.xlabel("Relative Importance Score")
plt.grid(True, linestyle='--', alpha=0.5)

plt.tight_layout()
plt.show()
